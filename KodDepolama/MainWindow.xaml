<Window x:Class="KodDepolama.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:mdxam="clr-namespace:MdXaml;assembly=MdXaml"
        xmlns:vm="clr-namespace:DevSnippetManager.ViewModels"
        xmlns:local="clr-namespace:KodDepolama"
        Title="DevVault - Kod Parçacığı Yöneticisi" Height="720" Width="1100"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        SizeChanged="Window_SizeChanged"
        Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <local:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis"/>
        <local:StringEmptyToVisibilityConverter x:Key="StringEmptyToVis"/>
        <local:PositiveIntToVisibilityConverter x:Key="PositiveIntToVis"/>
        <local:DoubleToGridLengthConverter x:Key="DoubleToGridLength"/>
        <local:CodePreviewVisibilityConverter x:Key="CodePreviewToVis"/>

        <Style x:Key="ThemedMarkdownDocumentStyle" TargetType="FlowDocument">
            <Setter Property="FontFamily" Value="{DynamicResource MaterialDesignFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="PagePadding" Value="0"/>
        </Style>

        <Style x:Key="TagChipToggleStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ChipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource MaterialDesignSelection}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header / ColorZone -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="20,12" materialDesign:ElevationAssist.Elevation="Dp4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="CodeBracesBox" Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel>
                        <TextBlock Text="DevVault" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="Profesyonel Kod Parçacığı Yöneticisi" FontSize="12" Opacity="0.8"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleThemeCommand}"
                            Style="{StaticResource MaterialDesignToolForegroundButton}"
                            Width="38" Height="38"
                            Margin="0,0,4,0"
                            ToolTip="Temayı değiştir">
                        <materialDesign:PackIcon Width="22" Height="22">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Kind" Value="WeatherSunny"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                                            <Setter Property="Kind" Value="WeatherNight"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                    </Button>
                    <Button Click="BtnSettings_Click"
                            Style="{StaticResource MaterialDesignToolForegroundButton}"
                            Width="38" Height="38"
                            ToolTip="Ayarlar">
                        <materialDesign:PackIcon Kind="CogOutline" Width="22" Height="22"/>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:ColorZone>

        <!-- Content Area -->
        <Grid x:Name="MainContentGrid" Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="{Binding SidebarWidth, Mode=TwoWay, Converter={StaticResource DoubleToGridLength}}" MinWidth="260" MaxWidth="600"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Card -->
            <materialDesign:Card Grid.Column="0" UniformCornerRadius="8" Padding="16" materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" materialDesign:HintAssist.Hint="Kodlarda Ara... (Ctrl+F)" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" x:Name="SearchBox" />

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" materialDesign:HintAssist.Hint="Dil" Style="{StaticResource MaterialDesignFloatingHintComboBox}" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguageFilter}"/>
                        <ComboBox Grid.Column="2" materialDesign:HintAssist.Hint="Klasör" Style="{StaticResource MaterialDesignFloatingHintComboBox}" ItemsSource="{Binding FolderFilters}" SelectedItem="{Binding SelectedFolderFilter}"/>
                    </Grid>

                    <ComboBox Grid.Row="2" materialDesign:HintAssist.Hint="Sırala" Style="{StaticResource MaterialDesignFloatingHintComboBox}" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}" Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="3" Margin="0,0,0,10">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Etiketler" FontSize="12" FontWeight="SemiBold" Opacity="0.75" VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="Temizle"
                                    Command="{Binding ClearTagFiltersCommand}"
                                    Visibility="{Binding HasTagFilter, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="22"
                                    Padding="6,0"
                                    FontSize="11"
                                    VerticalAlignment="Center"/>
                        </Grid>
                        <ScrollViewer MaxHeight="88" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding TagFilters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Style="{StaticResource TagChipToggleStyle}"
                                                      Margin="0,0,6,6">
                                            <TextBlock FontSize="11">
                                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                                <Run Text=" ("/>
                                                <Run Text="{Binding Count, Mode=OneWay}"/>
                                                <Run Text=")"/>
                                            </TextBlock>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <ListBox Grid.Row="4"
                             ItemsSource="{Binding FilteredSnippets}"
                             SelectedItem="{Binding SelectedSnippet}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="-8,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" CornerRadius="4" Background="Transparent" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSourceMissing}" Value="True">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                    Width="26" Height="26"
                                                    Padding="0"
                                                    Margin="4,0,0,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Favorilere ekle/çıkar"
                                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Width="16" Height="16">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Kind" Value="StarOutline"/>
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                    <Setter Property="Kind" Value="Star"/>
                                                                    <Setter Property="Foreground" Value="#FFC107"/>
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.7" MaxHeight="34" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,4,0,4"/>
                                        <Border CornerRadius="4"
                                                Padding="6,4"
                                                Margin="0,0,0,6"
                                                Background="{DynamicResource MaterialDesignToolBarBackground}">
                                            <Border.Visibility>
                                                <MultiBinding Converter="{StaticResource CodePreviewToVis}">
                                                    <Binding Path="DataContext.ShowCodePreview" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    <Binding Path="CodePreview"/>
                                                </MultiBinding>
                                            </Border.Visibility>
                                            <TextBlock Text="{Binding CodePreview}"
                                                       FontFamily="Cascadia Mono, Consolas, Courier New"
                                                       FontSize="11"
                                                       Opacity="0.6"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="48"/>
                                        </Border>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="CodeTags" Width="13" Height="13" Opacity="0.6" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Language}" FontSize="11" Opacity="0.6" FontStyle="Italic" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                  Visibility="{Binding Folder, Converter={StaticResource StringNotEmptyToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Grid.Column="0" Kind="FolderOutline" Width="13" Height="13" Opacity="0.6" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Folder}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </Grid>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="LinkOff"
                                                                         Width="13" Height="13"
                                                                         Opacity="0.8"
                                                                         Margin="0,0,6,0"
                                                                         VerticalAlignment="Center"
                                                                         ToolTip="Kaynakta artık yok"
                                                                         Visibility="{Binding IsSourceMissing, Converter={StaticResource BoolToVis}}"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding UsageCount, Converter={StaticResource PositiveIntToVis}}">
                                                    <materialDesign:PackIcon Kind="ContentCopy" Width="12" Height="12" Opacity="0.6" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding UsageCount}" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="5" Margin="0,12,0,0">
                        <!-- Scan progress bar (only while scanning) -->
                        <Grid Visibility="{Binding ProjectScan.IsScanning, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding ProjectScan.ScanProgressText}"
                                           FontSize="11"
                                           Opacity="0.75"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="İptal"
                                        Command="{Binding ProjectScan.CancelScanCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Height="20"
                                        Padding="6,0"
                                        FontSize="11"/>
                            </Grid>
                            <ProgressBar Grid.Row="1"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ProjectScan.ScanProgressValue}"
                                         Height="4"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding NewSnippetCommand}" Padding="8,0" ToolTip="Yeni Ekle">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Plus" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Yeni" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding NewFromClipboardCommand}" Padding="8,0" Style="{StaticResource MaterialDesignOutlinedButton}" ToolTip="Panodan yeni snippet (Ctrl+Shift+V)">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ClipboardArrowDownOutline" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Panodan" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Button x:Name="BtnScanProject"
                                Click="BtnScanProject_Click"
                                Margin="0,8,0,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                ToolTip="Projeden veya dosyalardan snippet çıkar">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="FolderSearchOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Projeden ekle" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <UniformGrid Columns="4" Margin="-3,8,-3,0">
                            <Button Command="{Binding ImportCommand}" Margin="3,0" Padding="0" Style="{StaticResource MaterialDesignOutlinedButton}" ToolTip="İçe Aktar">
                                <materialDesign:PackIcon Kind="FileImportOutline" />
                            </Button>
                            <Button Command="{Binding ExportCommand}" Margin="3,0" Padding="0" Style="{StaticResource MaterialDesignOutlinedButton}" ToolTip="Dışa Aktar">
                                <materialDesign:PackIcon Kind="FileExportOutline" />
                            </Button>
                            <Button Command="{Binding BackupNowCommand}" Margin="3,0" Padding="0" Style="{StaticResource MaterialDesignOutlinedButton}" ToolTip="Şimdi yedek al">
                                <materialDesign:PackIcon Kind="BackupRestore" />
                            </Button>
                            <Button Command="{Binding OpenBackupFolderCommand}" Margin="3,0" Padding="0" Style="{StaticResource MaterialDesignOutlinedButton}" ToolTip="Yedek klasörünü aç">
                                <materialDesign:PackIcon Kind="FolderOpenOutline" />
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="Transparent"
                          Cursor="SizeWE"
                          ToolTip="Genişliği ayarla (sıfırlamak için çift tıklayın)"
                          MouseDoubleClick="SidebarSplitter_MouseDoubleClick">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border x:Name="SplitterLine"
                                    Width="2"
                                    CornerRadius="1"
                                    HorizontalAlignment="Center"
                                    Margin="0,12"
                                    Background="{DynamicResource MaterialDesignDivider}"
                                    Opacity="0.5"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SplitterLine" Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                <Setter TargetName="SplitterLine" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="SplitterLine" Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                <Setter TargetName="SplitterLine" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- Editor Card -->
            <materialDesign:Card Grid.Column="2" UniformCornerRadius="8" Padding="16" materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="145"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="145"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" MinWidth="160" materialDesign:HintAssist.Hint="Başlık" Style="{StaticResource MaterialDesignFloatingHintTextBox}" FontSize="16" FontWeight="SemiBold" Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Grid.Column="2"
                                  IsEditable="True"
                                  materialDesign:HintAssist.Hint="Programlama Dili"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                  ItemsSource="{Binding EditLanguages}"
                                  Text="{Binding EditLanguage, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Grid.Column="4"
                                  IsEditable="True"
                                  materialDesign:HintAssist.Hint="Klasör"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                  ItemsSource="{Binding EditFolders}"
                                  Text="{Binding EditFolder, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="6"
                                Command="{Binding ToggleFavoriteCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Width="36" Height="36"
                                VerticalAlignment="Bottom"
                                ToolTip="Favorilere ekle/çıkar">
                            <materialDesign:PackIcon Width="22" Height="22">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="StarOutline"/>
                                        <Setter Property="Opacity" Value="0.6"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditIsFavorite}" Value="True">
                                                <Setter Property="Kind" Value="Star"/>
                                                <Setter Property="Foreground" Value="#FFC107"/>
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBox materialDesign:HintAssist.Hint="Etiketler (Virgülle ayırın)" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Text="{Binding EditTags, UpdateSourceTrigger=PropertyChanged}"/>
                        <Grid Visibility="{Binding HasEditSourceInfo, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding EditSourceInfo}"
                                       FontSize="11.5"
                                       Opacity="0.7"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1"
                                    Visibility="{Binding EditIsSourceMissing, Converter={StaticResource BoolToVis}}"
                                    Background="#33FF5252"
                                    CornerRadius="4"
                                    Padding="6,1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="kaynakta artık yok" FontSize="11"/>
                            </Border>
                            <Button Grid.Column="2"
                                    Content="Dosyayı aç"
                                    Command="{Binding OpenSourceFileCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="22"
                                    Padding="6,0"
                                    Margin="6,0,0,0"
                                    FontSize="11.5"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- Description with Markdown Edit / Preview -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Açıklama / Notlar"
                                       FontSize="11.5"
                                       Opacity="0.7"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Command="{Binding ToggleDescriptionPreviewCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Width="24" Height="24"
                                    Padding="0">
                                <Button.ToolTip>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Önizle"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDescriptionPreview}" Value="True">
                                                        <Setter Property="Text" Value="Düzenle"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button.ToolTip>
                                <materialDesign:PackIcon Width="15" Height="15">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="EyeOutline"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDescriptionPreview}" Value="True">
                                                    <Setter Property="Kind" Value="PencilOutline"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </Button>
                        </Grid>

                        <TextBox x:Name="DescriptionTextBox"
                                 Visibility="{Binding IsDescriptionPreview, Converter={StaticResource InvBoolToVis}}"
                                 materialDesign:HintAssist.Hint="Açıklama / Notlar (Markdown desteklenir)"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MaxHeight="96"
                                 VerticalScrollBarVisibility="Auto"/>

                        <Border Visibility="{Binding IsDescriptionPreview, Converter={StaticResource BoolToVis}}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                CornerRadius="4"
                                Padding="8,6"
                                MinHeight="48"
                                MaxHeight="110"
                                Background="Transparent"
                                Cursor="IBeam"
                                PreviewMouseLeftButtonUp="DescriptionPreview_MouseLeftButtonUp">
                            <Grid>
                                <mdxam:MarkdownScrollViewer Markdown="{Binding EditDescription}"
                                                            MarkdownStyle="{StaticResource ThemedMarkdownDocumentStyle}"
                                                            Foreground="{DynamicResource MaterialDesignBody}"
                                                            Background="Transparent"
                                                            FontSize="13"
                                                            VerticalScrollBarVisibility="Auto"
                                                            HorizontalScrollBarVisibility="Disabled"
                                                            Visibility="{Binding EditDescription, Converter={StaticResource StringNotEmptyToVis}}"/>
                                <TextBlock Text="Açıklama yok — düzenlemek için tıklayın"
                                           FontStyle="Italic"
                                           Opacity="0.55"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding EditDescription, Converter={StaticResource StringEmptyToVis}}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- WebView2 for Monaco Editor -->
                    <Border Grid.Row="3" Margin="0,0,0,16" BorderThickness="1" BorderBrush="{DynamicResource MaterialDesignDivider}" Background="{DynamicResource MaterialDesignPaper}" CornerRadius="4" ClipToBounds="True">
                        <Grid>
                            <wv2:WebView2 x:Name="webView" Visibility="Hidden"/>
                            <TextBlock x:Name="EditorErrorText" Text="Editör yüklenemedi." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>
                        </Grid>
                    </Border>

                    <WrapPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding AskAiCommand}" Margin="0,4,10,0" Style="{StaticResource MaterialDesignOutlinedButton}" ToolTip="Yapay zekâya sor — soruyu panoya kopyala">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="LightbulbOutline" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Yapay zekâya sor" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowHistoryCommand}" Margin="0,4,10,0" Style="{StaticResource MaterialDesignOutlinedButton}" ToolTip="Sürüm geçmişi">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="History" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Geçmiş" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CopySnippetCommand}" Margin="0,4,12,0" Style="{StaticResource MaterialDesignOutlinedButton}" ToolTip="Kopyala (Ctrl+Shift+C)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentCopy" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Kopyala" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Click="BtnShortcuts_Click" Margin="0,4,12,0" Style="{StaticResource MaterialDesignOutlinedButton}" ToolTip="Kısayolları Göster">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="KeyboardOutline" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Kısayollar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteSnippetCommand}" Margin="0,4,12,0" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#ff5252" BorderBrush="#ff5252" ToolTip="Bu kaydı sil">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TrashCanOutline" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Sil" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveSnippetCommand}" Margin="0,4,0,0" ToolTip="Kaydet (Ctrl+S)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Kaydet" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <materialDesign:Snackbar Grid.Row="1"
                                 MessageQueue="{Binding MessageQueue}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,16" />
    </Grid>
</Window>
