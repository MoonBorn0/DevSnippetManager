<Window x:Class="DevSnippetManager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Ayarlar"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <!-- Görünüm -->
            <TextBlock Text="Görünüm"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                       Margin="0,0,0,10"/>

            <ComboBox materialDesign:HintAssist.Hint="Tema"
                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                      ItemsSource="{Binding ThemeOptions}"
                      SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                      Margin="0,0,0,14"/>

            <DockPanel Margin="0,0,0,16">
                <ToggleButton DockPanel.Dock="Right"
                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                              IsChecked="{Binding ShowCodePreview, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                <TextBlock Text="Listede kod önizlemesi göster"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <Separator Margin="0,0,0,16" Background="{DynamicResource MaterialDesignDivider}"/>

            <!-- Editör -->
            <TextBlock Text="Editör"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                       Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right"
                            Content="Sıfırla"
                            Command="{Binding ResetFontSizeCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="24"
                            Padding="8,0"
                            FontSize="12"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Yazı boyutu: " VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding EditorFontSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text=" px" Opacity="0.7" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
                <Slider Grid.Row="1"
                        Minimum="10"
                        Maximum="28"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Value="{Binding EditorFontSize, Mode=TwoWay}"
                        VerticalAlignment="Center"/>
            </Grid>

            <DockPanel Margin="0,0,0,12">
                <ToggleButton DockPanel.Dock="Right"
                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                              IsChecked="{Binding EditorWordWrap, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                <TextBlock Text="Satır kaydırma"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <DockPanel Margin="0,0,0,16">
                <ToggleButton DockPanel.Dock="Right"
                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                              IsChecked="{Binding EditorMinimap, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                <TextBlock Text="Mini harita"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <Separator Margin="0,0,0,16" Background="{DynamicResource MaterialDesignDivider}"/>

            <!-- Uygulama -->
            <TextBlock Text="Uygulama"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                       Margin="0,0,0,10"/>

            <DockPanel Margin="0,0,0,20">
                <ToggleButton DockPanel.Dock="Right"
                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                              IsChecked="{Binding Settings.MinimizeToTray, Mode=TwoWay}"
                              Click="MinimizeToTrayToggle_Click"
                              VerticalAlignment="Center"/>
                <TextBlock Text="Kapatınca tepsiye küçült"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Kapat"
                    IsDefault="True"
                    IsCancel="True"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
