<Window x:Class="DevSnippetManager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:KodDepolama"
        Title="Ayarlar"
        Width="460"
        SizeToContent="Height"
        MaxHeight="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,0">
                <!-- Görünüm -->
                <TextBlock Text="Görünüm"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                           Margin="0,0,0,10"/>

                <ComboBox materialDesign:HintAssist.Hint="Tema"
                          Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                          ItemsSource="{Binding ThemeOptions}"
                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                          Margin="0,0,0,14"/>

                <DockPanel Margin="0,0,0,16">
                    <ToggleButton DockPanel.Dock="Right"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  IsChecked="{Binding ShowCodePreview, Mode=TwoWay}"
                                  VerticalAlignment="Center"/>
                    <TextBlock Text="Listede kod önizlemesi göster"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <Separator Margin="0,0,0,16" Background="{DynamicResource MaterialDesignDivider}"/>

                <!-- Editör -->
                <TextBlock Text="Editör"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                           Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right"
                                Content="Sıfırla"
                                Command="{Binding ResetFontSizeCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Height="24"
                                Padding="8,0"
                                FontSize="12"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Yazı boyutu: " VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding EditorFontSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text=" px" Opacity="0.7" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                    <Slider Grid.Row="1"
                            Minimum="10"
                            Maximum="28"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding EditorFontSize, Mode=TwoWay}"
                            VerticalAlignment="Center"/>
                </Grid>

                <DockPanel Margin="0,0,0,12">
                    <ToggleButton DockPanel.Dock="Right"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  IsChecked="{Binding EditorWordWrap, Mode=TwoWay}"
                                  VerticalAlignment="Center"/>
                    <TextBlock Text="Satır kaydırma"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <DockPanel Margin="0,0,0,16">
                    <ToggleButton DockPanel.Dock="Right"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  IsChecked="{Binding EditorMinimap, Mode=TwoWay}"
                                  VerticalAlignment="Center"/>
                    <TextBlock Text="Mini harita"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <Separator Margin="0,0,0,16" Background="{DynamicResource MaterialDesignDivider}"/>

                <!-- Uygulama -->
                <TextBlock Text="Uygulama"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                           Margin="0,0,0,10"/>

                <DockPanel Margin="0,0,0,16">
                    <ToggleButton DockPanel.Dock="Right"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  IsChecked="{Binding Settings.MinimizeToTray, Mode=TwoWay}"
                                  Click="MinimizeToTrayToggle_Click"
                                  VerticalAlignment="Center"/>
                    <TextBlock Text="Kapatınca tepsiye küçült"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <Separator Margin="0,0,0,16" Background="{DynamicResource MaterialDesignDivider}"/>

                <!-- Senkronizasyon (GitHub Gist) -->
                <TextBlock Text="Senkronizasyon (GitHub Gist)"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                           Margin="0,0,0,10"/>

                <!-- No token state -->
                <StackPanel Visibility="{Binding Sync.HasGitHubToken, Converter={StaticResource InvBoolToVis}}"
                            Margin="0,0,0,12">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="GitHubTokenBox"
                                     Grid.Column="0"
                                     materialDesign:HintAssist.Hint="GitHub kişisel erişim token'ı"
                                     Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                     VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                Content="Kaydet ve doğrula"
                                Click="SaveTokenButton_Click"
                                VerticalAlignment="Bottom">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Sync.IsSyncBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <TextBlock FontSize="12">
                        <Hyperlink NavigateUri="https://github.com/settings/tokens/new?scopes=gist&amp;description=DevVault"
                                   RequestNavigate="TokenLink_RequestNavigate"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}">
                            Token oluştur (gist izni)
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <!-- Token saved state -->
                <DockPanel Visibility="{Binding Sync.HasGitHubToken, Converter={StaticResource BoolToVis}}"
                           Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right"
                            Content="Token'ı kaldır"
                            Command="{Binding Sync.ClearGitHubTokenCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="28"
                            Padding="10,0"
                            FontSize="12"/>
                    <TextBlock Text="Token kayıtlı ✓"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryHueMidBrush}"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Gist ID -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             materialDesign:HintAssist.Hint="Gist ID / bağlantı (boşsa yeni oluşturulur)"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             Text="{Binding Sync.GistId, UpdateSourceTrigger=LostFocus}"/>
                    <Button Grid.Column="2"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Width="32" Height="32"
                            VerticalAlignment="Bottom"
                            ToolTip="Gist ID kopyala"
                            Click="CopyGistIdButton_Click">
                        <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16"/>
                    </Button>
                </Grid>

                <!-- Push / Pull buttons -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Command="{Binding Sync.PushToGistCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="CloudUploadOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Gist'e gönder" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2"
                            Command="{Binding Sync.PullFromGistCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="CloudDownloadOutline" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Gist'ten al" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <ProgressBar IsIndeterminate="True"
                             Height="3"
                             Margin="0,0,0,6"
                             Visibility="{Binding Sync.IsSyncBusy, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Text="{Binding Sync.SyncStatusText}"
                           FontSize="11.5"
                           Opacity="0.7"
                           Margin="0,0,0,12"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Kapat"
                    IsDefault="True"
                    IsCancel="True"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
